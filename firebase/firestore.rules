rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function own(uid) { return request.auth != null && request.auth.uid == uid; }
  match /users/{uid}/data/bloom {
   allow read, delete: if own(uid);
   allow create, update: if own(uid) && request.resource.data.keys().hasOnly(['state', 'updatedAt']) && request.resource.data.state is map && request.resource.data.state.version == 1;
  }
  match /users/{uid}/devices/{device} {
   allow read, delete: if own(uid);
   allow create, update: if own(uid) && request.resource.data.keys().hasOnly(['token', 'updatedAt']) && request.resource.data.token is string && request.resource.data.token.size() < 4096 && request.resource.data.updatedAt is number;
  }
  match /users/{uid}/reminders/{reminder} {
   allow read, delete: if own(uid);
   allow create, update: if own(uid) && request.resource.data.keys().hasOnly(['title', 'dueAt', 'taskId', 'url']) && request.resource.data.title is string && request.resource.data.title.size() <= 140 && request.resource.data.dueAt is number && request.resource.data.taskId is string && request.resource.data.url is string;
  }
 }
}
